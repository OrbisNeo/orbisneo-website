{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/welkom/",
        "http://localhost:4173/services/",
        "http://localhost:4173/blog/agent-sprawl-the-new-shadow-it/",
        "http://localhost:4173/contact/"
      ],
      "numberOfRuns": 1,
      "startServerCommand": "npx --yes serve@14 dist -l 4173",
      "startServerReadyPattern": "Accepting connections",
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "reports/mobile"
    }
  }
}
