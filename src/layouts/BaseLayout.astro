---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/source-sans-3";
import "../styles/tokens.css";
import "../styles/base.css";

import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import type { Alternates } from "../i18n/routes";
import { alternatesFor } from "../i18n/routes";
import Seo from "../components/Seo.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  showChrome?: boolean;
  alternates?: Alternates;
  noindex?: boolean;
}

const { title, description, lang = "en", showChrome = true, alternates, noindex } = Astro.props;
const copy = t(lang);
const alts: Alternates = alternates ?? alternatesFor(lang, Astro.url.pathname);
const altPath = lang === "en" ? alts.nl : alts.en;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo title={title} description={description} lang={lang} alternates={alts} noindex={noindex} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skipLink}</a>
    {showChrome && <SiteHeader lang={lang} altPath={altPath} />}
    <main id="main">
      <slot />
    </main>
    {showChrome && <SiteFooter lang={lang} />}
    <script>
      import "../scripts/lang-switch.ts";
      import "../scripts/analytics.ts";
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: 0;
    left: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-action);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    border-radius: 0 0 var(--radius-sm) 0;
    transform: translateY(-120%);
    transition: transform var(--duration-fast) var(--ease-out);
    z-index: calc(var(--z-overlay) + 1);
  }

  .skip-link:focus {
    transform: translateY(0);
    outline-offset: 3px;
  }

  main {
    min-height: 50vh;
  }
</style>
