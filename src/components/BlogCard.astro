---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { Lang } from "../i18n/ui";

interface Props {
  post: CollectionEntry<"blog">;
  lang: Lang;
  featured?: boolean;
}

const { post, lang, featured = false } = Astro.props;
const href = `/blog/${post.data.urlSlug}/`;
const dateLabel = post.data.pubDate.toLocaleDateString(lang === "en" ? "en-GB" : "nl-NL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<article class={`blog-card ${featured ? "blog-card--featured" : ""}`}>
  <a href={href} class="blog-card__link">
    {post.data.heroImage && (
      <div class="blog-card__image">
        <Image
          src={post.data.heroImage}
          alt={post.data.heroAlt ?? post.data.title}
          widths={featured ? [720, 1080, 1280] : [360, 540, 720]}
          sizes={featured
            ? "(max-width: 767px) 100vw, 1200px"
            : "(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 400px"}
          loading="lazy"
        />
      </div>
    )}
    <div class="blog-card__body">
      <p class="blog-card__meta">
        <span class="blog-card__category">{post.data.category}</span>
        <span class="blog-card__date">
          <time datetime={post.data.pubDate.toISOString()}>{dateLabel}</time>
        </span>
      </p>
      <h3 class="blog-card__title">{post.data.title}</h3>
      <p class="blog-card__description">{post.data.description}</p>
    </div>
  </a>
</article>

<style>
  .blog-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  .blog-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-neo);
  }

  .blog-card__link {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .blog-card__image {
    aspect-ratio: 16 / 10;
    background: var(--color-mist);
    overflow: hidden;
  }

  .blog-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .blog-card:hover .blog-card__image :global(img) {
    transform: scale(1.03);
  }

  .blog-card__body {
    padding: var(--space-5);
  }

  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-text-soft);
    margin: 0 0 var(--space-3);
  }

  .blog-card__category {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-action);
  }

  .blog-card__title {
    font-size: var(--fs-h3);
    margin: 0 0 var(--space-3);
    line-height: var(--lh-heading);
  }

  .blog-card:hover .blog-card__title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .blog-card__description {
    color: var(--color-text-soft);
    margin: 0;
  }

  .blog-card--featured {
    grid-column: 1 / -1;
  }

  .blog-card--featured .blog-card__image {
    aspect-ratio: 21 / 9;
  }

  .blog-card--featured .blog-card__title {
    font-size: var(--fs-h2);
  }

  .blog-card--featured .blog-card__body {
    padding: var(--space-6);
  }
</style>
