---
import { Image } from "astro:assets";
import backdrop from "../assets/backdrops/zakenman-rapport.jpg";

interface Props {
  /** Mirror the photo, so the busy part (hand and pen) lands behind the portrait on the right. */
  flip?: boolean;
}

const { flip = false } = Astro.props;
---

<!--
  Decorative photo behind the page heading, calmer than the home hero.
  Tune with CSS custom properties on .page-backdrop (blur, scrim, position, height).
-->
<div class="page-backdrop" data-flip={flip ? "" : undefined} data-page-backdrop aria-hidden="true">
  <div class="page-backdrop__box">
    <Image
      src={backdrop}
      alt=""
      widths={[720, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="low"
      decoding="async"
    />
    <div class="page-backdrop__scrim"></div>
  </div>
</div>

<script>
  const box = document.querySelector<HTMLElement>("[data-page-backdrop] .page-backdrop__box");

  if (box && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // Fixed on desktop: fade out while the page scrolls over it. Below 1024 px it scrolls along.
    const fixedMq = matchMedia("(min-width: 1024px)");
    const update = () => {
      if (!fixedMq.matches) {
        box.style.opacity = "";
        return;
      }
      const h = box.getBoundingClientRect().height || 1;
      box.style.opacity = String(Math.max(0, Math.min(1, 1 - window.scrollY / (h * 0.7))));
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    fixedMq.addEventListener("change", update);
  }
</script>

<style>
  .page-backdrop {
    /* Adjust here after looking at the preview. */
    --backdrop-blur: 6px;
    --backdrop-scrim: 0.74;
    --backdrop-scrim-left: 0.92;
    --backdrop-position: 50% 62%;
    --backdrop-height: min(62svh, 520px);

    position: relative;
    height: 0;
    z-index: 0;
    pointer-events: none;
  }

  .page-backdrop__box {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--backdrop-height);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 45%, transparent 100%);
    transition: opacity 100ms linear;
  }

  .page-backdrop__box :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--backdrop-position);
    filter: blur(var(--backdrop-blur));
    /* Slightly larger, so the blur does not leave soft edges at the borders. */
    transform: scale(1.08);
  }

  .page-backdrop[data-flip] .page-backdrop__box :global(img) {
    transform: scale(1.08) scaleX(-1);
  }

  .page-backdrop__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(255, 255, 255, var(--backdrop-scrim-left)) 0%,
        rgba(255, 255, 255, var(--backdrop-scrim)) 60%,
        rgba(255, 255, 255, var(--backdrop-scrim)) 100%
      );
  }

  @media (min-width: 1024px) {
    .page-backdrop__box {
      position: fixed;
      top: var(--header-h-compact);
      will-change: opacity;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-backdrop__box {
      transition: none;
    }
  }
</style>
