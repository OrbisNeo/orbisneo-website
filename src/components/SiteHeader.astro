---
import { Image } from "astro:assets";
import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import { navRoutes, homeFor } from "../i18n/routes";
import LangSwitcher from "./LangSwitcher.astro";
import logo from "../assets/brand/logo.png";

interface Props {
  lang: Lang;
  path?: string;
  altPath?: string | null;
}

const { lang, path = Astro.url.pathname, altPath } = Astro.props;
const copy = t(lang);
const isActive = (href: string) => path === href;
---

<header class="site-header" data-site-header>
  <div class="site-header__bar">
  <div class="site-header__inner container">
    <a href={homeFor(lang)} class="site-header__brand" aria-label={copy.footer.brand}>
      <Image
        src={logo}
        alt="Orbis Neo Consulting"
        widths={[180, 360, 540]}
        sizes="(min-width: 1024px) 180px, 140px"
        loading="eager"
        class="site-header__logo"
      />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {navRoutes.map((route) => (
          <li>
            <a
              href={route[lang]}
              class={isActive(route[lang]) ? "is-active" : ""}
              aria-current={isActive(route[lang]) ? "page" : undefined}
            >
              {copy.nav[route.navKey]}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__right">
      <LangSwitcher lang={lang} path={path} altPath={altPath} />
      <button
        type="button"
        class="site-header__menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden" data-label-open>{copy.nav.menuOpen}</span>
        <span class="visually-hidden" data-label-close hidden>{copy.nav.menuClose}</span>
        <span class="site-header__menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu"
    hidden
    data-mobile-menu
  >
    <nav aria-label="Primary mobile">
      <ul>
        {navRoutes.map((route) => (
          <li>
            <a
              href={route[lang]}
              class={isActive(route[lang]) ? "is-active" : ""}
              aria-current={isActive(route[lang]) ? "page" : undefined}
            >
              {copy.nav[route.navKey]}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-menu__footer">
        <LangSwitcher lang={lang} path={path} altPath={altPath} />
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const openLabel = document.querySelector<HTMLElement>("[data-label-open]");
  const closeLabel = document.querySelector<HTMLElement>("[data-label-close]");

  if (btn && menu && openLabel && closeLabel) {
    const close = () => {
      btn.setAttribute("aria-expanded", "false");
      menu.hidden = true;
      openLabel.hidden = false;
      closeLabel.hidden = true;
      document.body.style.removeProperty("overflow");
    };

    const open = () => {
      btn.setAttribute("aria-expanded", "true");
      menu.hidden = false;
      openLabel.hidden = true;
      closeLabel.hidden = false;
      document.body.style.overflow = "hidden";
    };

    btn.addEventListener("click", () => {
      if (btn.getAttribute("aria-expanded") === "true") close();
      else open();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") close();
    });
  }

  // Shrinking sticky header: the outer element keeps its height, so nothing shifts.
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    let shrunk = false;
    let ticking = false;
    const apply = () => {
      ticking = false;
      const y = window.scrollY;
      // Hysteresis so the bar does not flicker around the threshold.
      if (!shrunk && y > 56) shrunk = true;
      else if (shrunk && y < 12) shrunk = false;
      header.toggleAttribute("data-shrunk", shrunk);
    };
    apply();
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  /*
    The outer header always occupies --header-h, so shrinking never moves the page.
    Only the bar inside changes size. Clicks pass through the transparent strip below it.
  */
  .site-header {
    --bar-h: var(--header-h);
    --logo: var(--logo-h);
    --nav-fs: 17px;
    --ui-scale: 1;
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-h);
    pointer-events: none;
  }

  .site-header[data-shrunk] {
    --bar-h: var(--header-h-compact);
    --logo: var(--logo-h-compact);
    --nav-fs: 14.5px;
    --ui-scale: 0.86;
  }

  .site-header__bar {
    height: var(--bar-h);
    background: var(--color-bg);
    pointer-events: auto;
    transition:
      height 240ms var(--ease-out),
      background-color 240ms var(--ease-out),
      box-shadow 240ms var(--ease-out);
  }

  .site-header[data-shrunk] .site-header__bar {
    background: rgba(255, 255, 255, 0.94);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: 100%;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }

  .site-header__brand :global(.site-header__logo) {
    display: block;
    height: var(--logo);
    width: auto;
    transition: height 240ms var(--ease-out);
  }

  .site-header__nav {
    display: flex;
    flex: 1;
    justify-content: center;
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--nav-fs);
    font-weight: 600;
    padding: var(--space-2) 0;
    transition: font-size 240ms var(--ease-out);
  }

  .site-header__nav a:hover,
  .site-header__nav a.is-active {
    text-decoration: underline;
    text-decoration-color: var(--color-neo);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .site-header__right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    transform: scale(var(--ui-scale));
    transform-origin: right center;
    transition: transform 240ms var(--ease-out);
  }

  .site-header__menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: var(--radius-sm);
  }

  .site-header__menu-icon {
    display: block;
    width: 24px;
    height: 18px;
    position: relative;
  }

  .site-header__menu-icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-text);
    border-radius: 1px;
  }

  .site-header__menu-icon span:nth-child(1) { top: 0; }
  .site-header__menu-icon span:nth-child(2) { top: 50%; transform: translateY(-50%); }
  .site-header__menu-icon span:nth-child(3) { bottom: 0; }

  .mobile-menu {
    position: fixed;
    inset: var(--bar-h) 0 0 0;
    background: var(--color-bg);
    padding: var(--space-6) var(--gutter);
    overflow-y: auto;
    pointer-events: auto;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-menu a {
    display: block;
    padding: var(--space-3) 0;
    font-size: 24px;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .mobile-menu a.is-active {
    color: var(--color-action);
  }

  .mobile-menu__footer {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 1023.98px) {
    .site-header__nav { display: none; }
    .site-header__menu-btn { display: inline-flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__bar,
    .site-header__brand :global(.site-header__logo),
    .site-header__nav a,
    .site-header__right {
      transition: none;
    }
  }
</style>
