---
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = lang === "en"
  ? {
      heading: "Want to find out whether this fits your situation?",
      body: "A first conversation takes fifteen minutes and is free of obligation.",
      cta: "Schedule an intro call",
      ctaHref: "/contact/",
      emailLabel: "or email directly",
    }
  : {
      heading: "Benieuwd of dit bij uw situatie past?",
      body: "Een eerste gesprek duurt vijftien minuten en is vrijblijvend.",
      cta: "Plan een kennismaking",
      ctaHref: "/kennismaken/",
      emailLabel: "of mail direct",
    };

const email = "info@orbisneoconsulting.com";
---

<section id="contact" class="contact-teaser" aria-labelledby="contact-teaser-heading">
  <div class="container">
    <h2 id="contact-teaser-heading">{copy.heading}</h2>
    <p>{copy.body}</p>
    <p>
      <a
        href={copy.ctaHref}
        class="link link--large"
        data-umami-event="cta-intro-click"
        data-umami-event-location="contact-teaser"
        data-umami-event-lang={lang}
      >{copy.cta} →</a>
    </p>
    <p class="contact-teaser__email">
      {copy.emailLabel}: <a
        href={`mailto:${email}`}
        data-umami-event="email-click"
        data-umami-event-location="contact-teaser"
      >{email}</a>
    </p>
  </div>
</section>

<style>
  .contact-teaser {
    background: var(--color-surface-warm);
    padding-block: var(--space-7);
    text-align: center;
  }

  .contact-teaser h2 {
    font-size: var(--fs-h3);
    margin: 0 0 var(--space-2);
  }

  .contact-teaser p {
    font-size: var(--fs-body);
    color: var(--color-text-soft);
    max-width: 48ch;
    margin: 0 auto var(--space-3);
  }

  .link--large {
    font-weight: 600;
    color: var(--color-action);
    text-decoration: none;
  }

  .link--large:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact-teaser__email {
    font-size: var(--fs-small);
    margin-top: var(--space-3);
    margin-bottom: 0;
  }

  .contact-teaser__email a {
    color: var(--color-action);
  }
</style>
