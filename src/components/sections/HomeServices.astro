---
import { getCollection } from "astro:content";
import type { Lang } from "../../i18n/ui";
import { inLang, sortByOrder } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const all = await getCollection("diensten");
const services = sortByOrder(inLang(all, lang));

const copy = lang === "en"
  ? {
      heading: "Four services. Each with a clear outcome.",
      intro: "Each service has a clear outcome, a fixed shape and a visible endpoint.",
      closing: "Which service fits your situation? Not sure? Start with the leadership review.",
      more: "See all services",
      moreHref: "/services/",
      contactHref: "/contact/",
      labels: { forWho: "For whom", duration: "Duration", delivery: "Delivery", price: "Pricing" },
    }
  : {
      heading: "Vier diensten. Elk met een duidelijke uitkomst.",
      intro: "Elke dienst heeft een helder resultaat, een vaste vorm en een zichtbaar eindpunt.",
      closing: "Welke dienst past bij uw situatie? Niet zeker? Begin met de directiescan.",
      more: "Bekijk alle diensten",
      moreHref: "/diensten/",
      contactHref: "/kennismaken/",
      labels: { forWho: "Voor wie", duration: "Duur", delivery: "Oplevering", price: "Tariefafspraak" },
    };
---

<section id="services" class="services" aria-labelledby="services-heading">
  <div class="container services__intro">
    <h2 id="services-heading">{copy.heading}</h2>
    <p>{copy.intro}</p>
  </div>

  {services.map((s, i) => (
    <article class="service-segment" data-reveal>
      <div class="container service-segment__inner">
        <p class="service-segment__number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
        <div class="service-segment__body">
          <div class="service-segment__head">
            <h3 class="service-segment__title">{s.data.title}</h3>
            <p class="service-segment__tagline">{s.data.tagline}</p>
          </div>
          <dl class="service-segment__meta">
            <div><dt>{copy.labels.forWho}</dt><dd>{s.data.forWho}</dd></div>
            <div><dt>{copy.labels.duration}</dt><dd>{s.data.duration}</dd></div>
            <div><dt>{copy.labels.delivery}</dt><dd>{s.data.delivery}</dd></div>
            <div><dt>{copy.labels.price}</dt><dd>{s.data.price}</dd></div>
          </dl>
        </div>
      </div>
    </article>
  ))}

  <div class="container services__closing">
    <p>{copy.closing}</p>
    <p>
      <a href={copy.moreHref} class="btn btn--secondary">{copy.more}</a>
    </p>
    <p class="services__ctaLine">
      <a
        href={copy.contactHref}
        data-umami-event="cta-intro-click"
        data-umami-event-location="services"
        data-umami-event-lang={lang}
      >{lang === "en" ? "Or request an introductory call →" : "Of vraag direct een kennismaking aan →"}</a>
    </p>
  </div>
</section>

<style>
  .services {
    background: var(--color-surface-warm);
  }

  .services__intro {
    padding-top: var(--section-y-compact);
    padding-bottom: var(--space-4);
  }

  .services__intro h2 {
    margin-bottom: var(--space-2);
  }

  .services__intro p {
    font-size: var(--fs-lead);
    color: var(--color-text-soft);
    margin: 0;
  }

  /* One compact row per service: all four fit on a large screen. */
  .service-segment {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .service-segment__inner {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .service-segment__number {
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-settings);
    font-size: clamp(2.25rem, 3.5vw, 3.25rem);
    font-weight: 600;
    color: var(--color-neo);
    line-height: 1;
    margin: 0;
  }

  .service-segment__body {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-5) var(--space-6);
    align-items: start;
  }

  .service-segment__title {
    font-size: var(--fs-h3);
    margin: 0 0 var(--space-1);
  }

  .service-segment__tagline {
    color: var(--color-text-soft);
    margin: 0;
    max-width: 38ch;
  }

  .service-segment__meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3) var(--space-5);
    margin: 0;
    font-size: var(--fs-small);
  }

  .service-segment__meta dt {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-soft);
    margin-bottom: 2px;
  }

  .service-segment__meta dd {
    margin: 0;
    line-height: 1.45;
  }

  .services__closing {
    padding-block: var(--space-6) var(--section-y-compact);
    text-align: center;
  }

  /* Global p has max-width 68ch; without auto margins the block sat left of centre. */
  .services__closing p {
    margin-inline: auto;
  }

  .services__closing p:first-child {
    font-size: var(--fs-lead);
    margin-bottom: var(--space-4);
  }

  .services__ctaLine {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
  }

  .services__ctaLine a {
    color: var(--color-action);
    font-weight: 600;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    font-weight: 700;
    font-size: var(--fs-label);
    letter-spacing: 0.02em;
    border-radius: var(--radius-pill);
    text-decoration: none;
    min-height: 44px;
    border: 2px solid var(--color-action);
  }

  .btn--secondary {
    color: var(--color-action);
    background: transparent;
  }

  .btn--secondary:hover {
    background: var(--color-mist);
  }

  @media (max-width: 1023.98px) {
    .service-segment__body {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  @media (max-width: 767.98px) {
    .service-segment__inner {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .service-segment__meta {
      grid-template-columns: 1fr;
    }
  }

  :global(.js) [data-reveal] > :global(*) {
    opacity: 0;
    transform: translateY(24px);
  }
  :global(.js) [data-reveal].is-visible > :global(*) {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--duration-reveal) var(--ease-out),
      transform var(--duration-reveal) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-reveal] > :global(*) { opacity: 1; transform: none; transition: none; }
  }
</style>
