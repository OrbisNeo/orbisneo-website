---
import { getCollection } from "astro:content";
import type { Lang } from "../../i18n/ui";
import { inLang } from "../../i18n/utils";
import BlogCard from "../BlogCard.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const all = await getCollection("blog", (p) => !p.data.draft);
const posts = inLang(all, lang)
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 3);

const copy = lang === "en"
  ? {
      heading: "Perspective",
      subtitle: "How I look at AI in organisations",
      more: "All articles",
      moreHref: "/blog/",
    }
  : {
      heading: "Visie",
      subtitle: "Hoe ik naar AI in organisaties kijk",
      more: "Alle artikelen",
      moreHref: "/blog/overzicht/",
    };
---

<section id="perspective" class="perspective" aria-labelledby="perspective-heading">
  <div class="container">
    <header class="perspective__header">
      <h2 id="perspective-heading">{copy.heading}</h2>
      <p class="perspective__subtitle">{copy.subtitle}</p>
    </header>

    <div class="perspective__grid" data-reveal>
      {posts.map((p) => <BlogCard post={p} lang={lang} />)}
    </div>

    <p class="perspective__more">
      <a href={copy.moreHref}>{copy.more} →</a>
    </p>
  </div>
</section>

<style>
  .perspective {
    padding-block: var(--section-y);
    background: var(--color-bg);
  }

  .perspective__header {
    margin-bottom: var(--space-7);
  }

  .perspective__subtitle {
    font-size: var(--fs-lead);
    color: var(--color-text-soft);
    margin: var(--space-2) 0 0;
  }

  .perspective__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .perspective__more {
    margin-top: var(--space-6);
    font-size: var(--fs-lead);
  }

  .perspective__more a {
    color: var(--color-action);
    font-weight: 600;
    text-decoration: none;
  }

  .perspective__more a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 1023.98px) {
    .perspective__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 767.98px) {
    .perspective__grid { grid-template-columns: 1fr; }
  }
</style>
