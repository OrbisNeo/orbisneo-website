---
import { Image } from "astro:assets";
import type { Lang } from "../../i18n/ui";
import bureau from "../../assets/people/daniel-bureau.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = lang === "en"
  ? {
      eyebrow: "For boards of mid-market and larger companies",
      heading: "AI is transforming your organisation from the inside.",
      lead: "I help you stay in control of the areas it affects most. Not awareness sessions, but practical direction.",
      scrollHint: "25 years in the domains AI is now changing most",
      cta: "Plan a short intro (15 min)",
      contactHref: "/contact/",
      portraitAlt: "Daniel Fokker at work",
    }
  : {
      eyebrow: "Voor directies van middelgrote en grote organisaties",
      heading: "AI verandert uw organisatie van binnenuit.",
      lead: "Ik help u grip houden op de gebieden waar het grootste effect zit. Geen awareness-sessies, maar praktische sturing.",
      scrollHint: "25 jaar in de domeinen die AI nu het sterkst verandert",
      cta: "Plan een kort kennismakingsgesprek (15 min)",
      contactHref: "/kennismaken/",
      portraitAlt: "Daniel Fokker aan het werk",
    };
---

<section class="opening" aria-labelledby="opening-heading" data-opening>
  <div class="opening__bg" data-opening-bg aria-hidden="true">
    <Image
      src={bureau}
      alt=""
      widths={[720, 1080, 1440, 1920]}
      sizes="100vw"
      loading="eager"
    />
  </div>
  <div class="opening__scrim" data-opening-bg aria-hidden="true"></div>

  <div class="opening__wrap container">
    <div class="opening__text">
      <p class="opening__eyebrow">{copy.eyebrow}</p>
      <h1 id="opening-heading" class="opening__heading">{copy.heading}</h1>
      <p class="opening__lead">{copy.lead}</p>
      <p class="opening__cta">
        <a href={copy.contactHref} class="opening__link">{copy.cta}</a>
      </p>
      <p class="opening__scroll">{copy.scrollHint}</p>
    </div>
  </div>
</section>

<script>
  const layers = Array.from(document.querySelectorAll<HTMLElement>("[data-opening-bg]"));
  const section = document.querySelector<HTMLElement>("[data-opening]");

  if (section && layers.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // Fade only applies when the background is fixed (desktop). On narrower
    // viewports the background scrolls with the section, so no opacity drive.
    const fixedMq = matchMedia("(min-width: 1024px)");

    const update = () => {
      if (!fixedMq.matches) {
        for (const el of layers) el.style.opacity = "";
        return;
      }
      const rect = section.getBoundingClientRect();
      const h = window.innerHeight || 800;
      const t = Math.max(0, Math.min(1, rect.bottom / h));
      const opacity = String(t);
      for (const el of layers) el.style.opacity = opacity;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    fixedMq.addEventListener("change", update);
  }
</script>

<style>
  .opening {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* Fixed layers: image + scrim stay in the viewport while the page scrolls over them. */
  .opening__bg,
  .opening__scrim {
    position: fixed;
    inset: 0;
    pointer-events: none;
    will-change: opacity;
    transition: opacity 100ms linear;
  }

  .opening__bg {
    z-index: 0;
  }

  .opening__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Position the crop so Daniel's head (at roughly 71% from left, 32% from top
       of the source photo) stays in view at every width. */
    object-position: 80% 40%;
  }

  @media (min-width: 1440px) {
    /* On wide screens the image is scaled to the viewport width and the head
       sits comfortably in the upper right; keep it near the right. */
    .opening__bg :global(img) {
      object-position: 90% 50%;
    }
  }

  .opening__scrim {
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.97) 0%,
        rgba(255, 255, 255, 0.94) 30%,
        rgba(255, 255, 255, 0.6) 55%,
        rgba(255, 255, 255, 0.15) 80%,
        rgba(255, 255, 255, 0) 100%
      );
  }

  .opening__wrap {
    position: relative;
    z-index: 2;
    padding-block: var(--section-y);
    width: 100%;
  }

  .opening__text {
    max-width: 580px;
  }

  .opening__eyebrow {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-soft);
    margin: 0 0 var(--space-4);
  }

  .opening__heading {
    font-size: var(--fs-display);
    font-weight: 650;
    line-height: var(--lh-tight);
    margin: 0 0 var(--space-5);
    color: var(--color-text);
    text-wrap: balance;
  }

  .opening__lead {
    font-size: var(--fs-lead);
    color: var(--color-text);
    margin: 0 0 var(--space-6);
    font-weight: 500;
  }

  .opening__cta {
    margin: 0;
  }

  .opening__link {
    display: inline-block;
    color: var(--color-action);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .opening__link:hover {
    color: var(--color-action-hover);
  }

  .opening__scroll {
    font-size: var(--fs-small);
    color: var(--color-text-soft);
    margin: var(--space-8) 0 0;
  }

  @media (max-width: 1023.98px) {
    /* On narrow screens the face sits in the TOP half of the viewport and
       the text drops to the bottom, so face and text do not overlap.
       Photo and scrim are absolute (not fixed) so they scroll with the
       hero; the text never crosses back over the face while scrolling. */
    .opening {
      display: block;
    }

    .opening__bg,
    .opening__scrim {
      position: absolute;
    }

    .opening__wrap {
      padding-top: 42svh;
      padding-bottom: var(--space-4);
    }

    .opening__lead {
      margin-bottom: var(--space-4);
    }

    .opening__bg :global(img) {
      /* 79% horizontally pins Daniel's face (at ~71% of the source) in the
         middle of the frame; 20% vertically keeps the head high. */
      object-position: 79% 20%;
    }

    .opening__scrim {
      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.1) 0%,
          rgba(255, 255, 255, 0.12) 30%,
          rgba(255, 255, 255, 0.85) 44%,
          rgba(255, 255, 255, 0.96) 58%,
          rgba(255, 255, 255, 0.96) 100%
        );
    }

    /* Smaller display size on mobile so the heading does not wrap into
       seven lines; lead and CTA fit above the fold. */
    .opening__heading {
      font-size: clamp(1.75rem, 1rem + 3.2vw, 2.25rem);
      line-height: 1.1;
      margin-bottom: var(--space-3);
    }

    .opening__eyebrow {
      margin-bottom: var(--space-3);
    }

    .opening__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening__bg,
    .opening__scrim {
      transition: none;
    }
  }
</style>
