---
import { Image } from "astro:assets";
import type { Lang } from "../../i18n/ui";
import bureau from "../../assets/people/daniel-bureau.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = lang === "en"
  ? {
      eyebrow: "For boards of mid-market and larger companies",
      heading: "AI is transforming your organisation from the inside.",
      lead: "I help you stay in control of the areas it affects most. Not awareness sessions, but practical direction.",
      scrollHint: "25 years in the domains AI is now changing most",
      cta: "Plan a short intro (15 min)",
      contactHref: "/contact/",
    }
  : {
      eyebrow: "Voor directies van middelgrote en grote organisaties",
      heading: "AI verandert uw organisatie van binnenuit.",
      lead: "Ik help u grip houden op de gebieden waar het grootste effect zit. Geen awareness-sessies, maar praktische sturing.",
      scrollHint: "25 jaar in de domeinen die AI nu het sterkst verandert",
      cta: "Plan een kennismaking (15 min)",
      contactHref: "/kennismaken/",
    };
---

<section class="opening" aria-labelledby="opening-heading" data-opening>
  <div class="opening__bg" data-opening-bg aria-hidden="true">
    <Image
      src={bureau}
      alt=""
      widths={[720, 1264]}
      sizes="(max-width: 1023px) 100vw, min(100vw, 1480px)"
      loading="eager"
      fetchpriority="high"
    />
    <div class="opening__scrim"></div>
  </div>

  <div class="opening__wrap container">
    <div class="opening__text">
      <p class="opening__eyebrow">{copy.eyebrow}</p>
      <h1 id="opening-heading" class="opening__heading">{copy.heading}</h1>
      <p class="opening__lead">{copy.lead}</p>
      <p class="opening__cta">
        <a
          href={copy.contactHref}
          class="opening__link"
          data-umami-event="cta-intro-click"
          data-umami-event-location="hero"
          data-umami-event-lang={lang}
        >{copy.cta}</a>
      </p>
      <p class="opening__scroll">{copy.scrollHint}</p>
    </div>
  </div>
</section>

<script>
  const bg = document.querySelector<HTMLElement>("[data-opening-bg]");
  const section = document.querySelector<HTMLElement>("[data-opening]");

  if (section && bg && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // The photo is fixed on desktop and fades out while the page scrolls over it.
    // Below 1024 px it scrolls with the hero, so no opacity drive there.
    const fixedMq = matchMedia("(min-width: 1024px)");

    const update = () => {
      if (!fixedMq.matches) {
        bg.style.opacity = "";
        return;
      }
      const rect = section.getBoundingClientRect();
      const h = window.innerHeight || 800;
      bg.style.opacity = String(Math.max(0, Math.min(1, rect.bottom / h)));
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    fixedMq.addEventListener("change", update);
  }
</script>

<style>
  .opening {
    position: relative;
    /* Header is sticky and in flow, so hero + header together fill one screen. */
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-content: center;
    isolation: isolate;
  }

  /*
    Photo box, fixed to the viewport while the page scrolls over it.
    Width is capped and the box is anchored right, so on wide or tall screens
    the photo is not enlarged: Daniel's head keeps its proportion and stays right.
    Soft fade on the left and bottom edge so the box dissolves into the page.
  */
  .opening__bg {
    --photo-w: min(100vw, 1480px);
    position: fixed;
    top: var(--header-h-compact);
    right: 0;
    width: var(--photo-w);
    height: min(calc(100svh - var(--header-h-compact)), calc(var(--photo-w) * 0.6));
    z-index: 0;
    pointer-events: none;
    will-change: opacity;
    transition: opacity 100ms linear;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 26%),
      linear-gradient(to bottom, #000 80%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, #000 26%),
      linear-gradient(to bottom, #000 80%, transparent 100%);
    mask-composite: intersect;
  }

  .opening__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Head sits at about 71% from the left and 32% from the top of the source. */
    object-position: 80% 30%;
  }

  .opening__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.97) 0%,
      rgba(255, 255, 255, 0.92) 30%,
      rgba(255, 255, 255, 0.55) 55%,
      rgba(255, 255, 255, 0.12) 80%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  .opening__wrap {
    position: relative;
    z-index: 2;
    padding-block: var(--section-y-compact);
    width: 100%;
  }

  .opening__text {
    max-width: 40rem;
  }

  .opening__eyebrow {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-soft);
    margin: 0 0 var(--space-3);
  }

  .opening__heading {
    font-size: clamp(2.25rem, 1.2rem + 2.6vw, 3.4rem);
    font-weight: 650;
    line-height: 1.08;
    margin: 0 0 var(--space-4);
    color: var(--color-text);
    text-wrap: balance;
  }

  .opening__lead {
    font-size: var(--fs-lead);
    color: var(--color-text);
    margin: 0 0 var(--space-5);
    font-weight: 500;
  }

  .opening__cta {
    margin: 0;
  }

  .opening__link {
    display: inline-block;
    color: var(--color-action);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .opening__link:hover {
    color: var(--color-action-hover);
  }

  .opening__scroll {
    font-size: var(--fs-small);
    color: var(--color-text-soft);
    margin: var(--space-6) 0 0;
  }

  @media (max-width: 1023.98px) {
    /*
      Narrow screens: face in the top half, text in the bottom half, so they never
      overlap. Photo and scrim scroll with the hero (absolute, not fixed).
    */
    .opening {
      display: block;
      min-height: 100svh;
    }

    .opening__bg {
      position: absolute;
      inset: 0;
      width: auto;
      height: auto;
      top: 0;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .opening__wrap {
      padding-top: 28svh;
      padding-bottom: var(--space-4);
    }

    .opening__eyebrow {
      margin-bottom: var(--space-2);
    }

    .opening__lead {
      font-size: 1.0625rem;
      line-height: 1.45;
      margin-bottom: var(--space-3);
    }

    .opening__bg :global(img) {
      /* 79% pins Daniel's face in the middle of the frame, 20% keeps the head high. */
      object-position: 79% 20%;
    }

    .opening__scrim {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.1) 0%,
        rgba(255, 255, 255, 0.12) 30%,
        rgba(255, 255, 255, 0.85) 44%,
        rgba(255, 255, 255, 0.96) 58%,
        rgba(255, 255, 255, 0.96) 100%
      );
    }

    .opening__heading {
      font-size: clamp(1.75rem, 1rem + 3.2vw, 2.25rem);
      line-height: 1.1;
      margin-bottom: var(--space-3);
    }

    .opening__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening__bg {
      transition: none;
    }
  }
</style>
