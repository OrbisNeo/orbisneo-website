---
import { Image } from "astro:assets";
import type { Lang } from "../../i18n/ui";
import bureau from "../../assets/people/daniel-bureau.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = lang === "en"
  ? {
      eyebrow: "For boards of mid-market and larger companies",
      heading: "AI is transforming your organisation from the inside.",
      lead: "I help you stay in control of the areas it affects most. Not awareness sessions, but practical direction.",
      scrollHint: "25 years in the domains AI is now changing most",
      cta: "Plan a short intro (15 min)",
      contactHref: "/contact/",
      portraitAlt: "Daniel Fokker at work",
    }
  : {
      eyebrow: "Voor directies van middelgrote en grote organisaties",
      heading: "AI verandert uw organisatie van binnenuit.",
      lead: "Ik help u grip houden op de gebieden waar het grootste effect zit. Geen awareness-sessies, maar praktische sturing.",
      scrollHint: "25 jaar in de domeinen die AI nu het sterkst verandert",
      cta: "Plan een kort kennismakingsgesprek (15 min)",
      contactHref: "/kennismaken/",
      portraitAlt: "Daniel Fokker aan het werk",
    };
---

<section class="opening" aria-labelledby="opening-heading" data-opening>
  <div class="opening__bg" data-opening-bg>
    <Image
      src={bureau}
      alt={copy.portraitAlt}
      widths={[720, 1080, 1440, 1920]}
      sizes="100vw"
      loading="eager"
    />
  </div>
  <div class="opening__scrim" aria-hidden="true"></div>

  <div class="opening__content container">
    <p class="opening__eyebrow">{copy.eyebrow}</p>
    <h1 id="opening-heading" class="opening__heading">{copy.heading}</h1>
    <p class="opening__lead">{copy.lead}</p>
    <a href={copy.contactHref} class="opening__link">{copy.cta}</a>
    <p class="opening__scroll">{copy.scrollHint}</p>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-opening]");
  const bg = document.querySelector<HTMLElement>("[data-opening-bg]");
  if (section && bg && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const update = () => {
      const rect = section.getBoundingClientRect();
      const h = window.innerHeight || 800;
      // fade from 1 at the top to 0 after one viewport of scrolling
      const t = Math.max(0, Math.min(1, 1 + rect.top / h));
      bg.style.opacity = String(t);
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }
</script>

<style>
  .opening {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .opening__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    will-change: opacity;
    transition: opacity 100ms linear;
  }

  .opening__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .opening__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.96) 0%,
        rgba(255, 255, 255, 0.9) 30%,
        rgba(255, 255, 255, 0.55) 55%,
        rgba(255, 255, 255, 0.1) 80%,
        rgba(255, 255, 255, 0) 100%
      );
    pointer-events: none;
  }

  .opening__content {
    position: relative;
    z-index: 2;
    padding-block: var(--section-y);
    max-width: 820px;
  }

  .opening__eyebrow {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-soft);
    margin: 0 0 var(--space-4);
  }

  .opening__heading {
    font-size: var(--fs-display);
    font-weight: 650;
    line-height: var(--lh-tight);
    margin: 0 0 var(--space-5);
    max-width: 15ch;
    color: var(--color-text);
    text-wrap: balance;
  }

  .opening__lead {
    font-size: var(--fs-lead);
    color: var(--color-text);
    margin: 0 0 var(--space-6);
    max-width: 48ch;
    font-weight: 500;
  }

  .opening__link {
    display: inline-block;
    color: var(--color-action);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .opening__link:hover {
    color: var(--color-action-hover);
  }

  .opening__scroll {
    font-size: var(--fs-small);
    color: var(--color-text-soft);
    margin: var(--space-7) 0 0;
  }

  @media (max-width: 1023.98px) {
    .opening__scrim {
      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.95) 0%,
          rgba(255, 255, 255, 0.85) 40%,
          rgba(255, 255, 255, 0.65) 70%,
          rgba(255, 255, 255, 0.3) 100%
        );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening__bg {
      transition: none;
    }
  }
</style>
