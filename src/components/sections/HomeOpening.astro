---
import { Image } from "astro:assets";
import type { Lang } from "../../i18n/ui";
import bureau from "../../assets/people/daniel-bureau.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = lang === "en"
  ? {
      eyebrow: "For boards of mid-market and larger companies",
      heading: "AI is transforming your organisation from the inside.",
      lead: "I help you stay in control of the areas it affects most. Not awareness sessions, but practical direction.",
      body: [
        "AI doesn't stop at one department. It changes how your organisation hangs together: how software gets built, how IT is run, how you deploy your people and what it all costs. Solve that domain by domain and you miss how those choices affect each other.",
        "I've spent twenty-five years in exactly those areas, from IT delivery and operations to enterprise architecture, HR and IT financial management. I work interim or part-time, for an agreed period and always with a clear endpoint.",
      ],
      cta: "Request an introductory call (15 min)",
      contactHref: "/contact/",
    }
  : {
      eyebrow: "Voor directies van middelgrote en grote organisaties",
      heading: "AI verandert uw organisatie van binnenuit.",
      lead: "Ik help u grip houden op de gebieden waar het grootste effect zit. Geen awareness-sessies, maar praktische sturing.",
      body: [
        "AI raakt niet één afdeling, maar de samenhang van uw organisatie: hoe software wordt gebouwd, hoe IT wordt beheerd, hoe u uw mensen inzet en wat het allemaal kost. Wie dat per domein oplost, mist hoe die keuzes op elkaar ingrijpen.",
        "Al vijfentwintig jaar werk ik in precies die domeinen, van IT-delivery en IT-beheer tot enterprise architecture, HR en IT financial management. Ik werk interim of op deeltijdbasis, voor een afgesproken periode en altijd met een helder eindpunt.",
      ],
      cta: "Vraag een kennismaking aan (15 min)",
      contactHref: "/kennismaken/",
    };
---

<section class="opening" aria-labelledby="opening-heading" data-opening>
  <div class="opening__bg" data-opening-bg aria-hidden="true">
    <Image
      src={bureau}
      alt=""
      widths={[720, 1264]}
      sizes="(max-width: 1023px) 100vw, min(100vw, 1440px)"
      loading="eager"
      fetchpriority="high"
    />
    <div class="opening__scrim"></div>
  </div>

  <div class="opening__wrap container">
    <div class="opening__text">
      <p class="opening__eyebrow">{copy.eyebrow}</p>
      <h1 id="opening-heading" class="opening__heading">{copy.heading}</h1>
      <p class="opening__lead">{copy.lead}</p>
      <div class="opening__body">
        {copy.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="opening__cta">
        <a
          href={copy.contactHref}
          class="opening__link"
          data-umami-event="cta-intro-click"
          data-umami-event-location="hero"
          data-umami-event-lang={lang}
        >{copy.cta}</a>
      </p>
    </div>
  </div>
</section>

<script>
  const bg = document.querySelector<HTMLElement>("[data-opening-bg]");
  const section = document.querySelector<HTMLElement>("[data-opening]");

  if (section && bg && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // The photo is fixed on desktop and fades out while the page scrolls over it.
    // Below 1024 px it scrolls with the hero, so no opacity drive there.
    const fixedMq = matchMedia("(min-width: 1024px)");

    const update = () => {
      if (!fixedMq.matches) {
        bg.style.opacity = "";
        return;
      }
      const rect = section.getBoundingClientRect();
      // Relative to the bottom of the photo box, so the photo starts fully visible on any screen.
      const bgBottom = bg.getBoundingClientRect().bottom || window.innerHeight || 800;
      bg.style.opacity = String(Math.max(0, Math.min(1, rect.bottom / bgBottom)));
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    fixedMq.addEventListener("change", update);
  }
</script>

<style>
  .opening {
    /* One continuous photo size for all widths: never larger than at 1440 px wide. */
    --photo-w: min(100vw, 1440px);
    --photo-h: min(calc(100svh - var(--header-h-compact)), max(calc(var(--photo-w) * 0.6), 45svh));
    position: relative;
    isolation: isolate;
  }

  /*
    Photo box. Desktop: fixed to the viewport while the page scrolls over it, anchored right,
    with a soft fade on the left and bottom edge. Below 1024 px it scrolls along with the hero.
  */
  .opening__bg {
    position: absolute;
    top: 0;
    right: 0;
    width: var(--photo-w);
    height: var(--photo-h);
    z-index: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 80%, transparent 100%);
  }

  .opening__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Head sits at about 71% from the left and 32% from the top of the source. */
    object-position: 79% 20%;
  }

  .opening__scrim {
    display: none;
  }

  .opening__wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: calc(var(--photo-h) * 0.8);
    padding-bottom: var(--section-y-compact);
  }

  .opening__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: var(--title-max);
  }

  .opening__eyebrow {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-soft);
    line-height: var(--lh-body);
    margin: 0 0 var(--space-3);
  }

  .opening__heading {
    font-size: var(--fs-h1);
    font-weight: 650;
    line-height: 1.1;
    margin: 0 0 var(--space-3);
    color: var(--color-text);
  }

  .opening__lead {
    font-size: var(--fs-lead);
    color: var(--color-text);
    margin: 0 0 var(--space-4);
    font-weight: 500;
  }

  .opening__body p {
    font-size: var(--fs-body);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  .opening__cta {
    margin: 0;
  }

  .opening__link {
    display: inline-block;
    color: var(--color-action);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .opening__link:hover {
    color: var(--color-action-hover);
  }

  /* Below 1024 px: eyebrow, heading, lead and CTA first, the two paragraphs after the CTA. */
  @media (max-width: 1023.98px) {
    .opening__cta {
      order: 1;
    }

    .opening__body {
      order: 2;
      margin-top: var(--space-5);
    }

    .opening__lead {
      font-size: 1.0625rem;
      line-height: 1.45;
      margin-bottom: var(--space-3);
    }
  }

  @media (min-width: 1024px) {
    .opening {
      /* Hero ends where the photo box ends (the fixed photo starts at the compact header). */
      min-height: calc(var(--photo-h) + var(--header-h-compact) - var(--header-h));
    }

    .opening__bg {
      position: fixed;
      top: var(--header-h-compact);
      will-change: opacity;
      transition: opacity 100ms linear;
      -webkit-mask-image:
        linear-gradient(to right, transparent 0%, #000 26%),
        linear-gradient(to bottom, #000 80%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent 0%, #000 26%),
        linear-gradient(to bottom, #000 80%, transparent 100%);
      mask-composite: intersect;
    }

    .opening__bg :global(img) {
      object-position: 80% 30%;
    }

    .opening__scrim {
      display: block;
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.97) 0%,
        rgba(255, 255, 255, 0.92) 30%,
        rgba(255, 255, 255, 0.55) 55%,
        rgba(255, 255, 255, 0.12) 80%,
        rgba(255, 255, 255, 0) 100%
      );
    }

    .opening__text {
      /* Same maximum as other page titles, but never wider than the part left of the face. */
      max-width: min(var(--title-max), 56vw);
    }

    .opening__wrap {
      /* Heading top = header + --page-head-pt, the same as the other pages. */
      padding-top: calc(var(--page-head-pt) - var(--fs-label) * var(--lh-body) - var(--space-3));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening__bg {
      transition: none;
    }
  }
</style>
