---
import { Image } from "astro:assets";
import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import { navRoutes, routes, homeFor } from "../i18n/routes";
import logo from "../assets/brand/logo.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const privacy = routes.find((r) => r.en === "/privacy/")!;
const news = routes.find((r) => r.en === "/news/")!;
const year = new Date().getFullYear();

const socials: Array<{ label: string; href: string }> = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/danielfokker" },
];

const email = "info@orbisneoconsulting.com";
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <a href={homeFor(lang)} class="site-footer__brand" aria-label={copy.footer.brand}>
      <Image
        src={logo}
        alt="Orbis Neo Consulting"
        widths={[180, 360, 540]}
        sizes="(min-width: 1024px) 180px, 140px"
        loading="lazy"
        class="site-footer__logo"
      />
    </a>

    <p class="site-footer__strapline">{copy.footer.strapline}</p>

    <nav class="site-footer__nav" aria-label={lang === "en" ? "Footer" : "Footer"}>
      <ul>
        {navRoutes.map((r) => (
          <li><a href={r[lang]}>{copy.nav[r.navKey]}</a></li>
        ))}
        <li><a href={news[lang]}>{lang === "en" ? "News" : "Nieuws"}</a></li>
        <li><a href={privacy[lang]}>{lang === "en" ? "Privacy" : "Privacybeleid"}</a></li>
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              rel="me noopener"
              target="_blank"
              data-umami-event={s.label === "LinkedIn" ? "linkedin-click" : "outbound-click"}
              data-umami-event-location="footer"
            >{s.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__meta">
      <span>{copy.footer.city}</span>
      <span aria-hidden="true">·</span>
      <a href={`mailto:${email}`} data-umami-event="email-click" data-umami-event-location="footer">{email}</a>
      <span aria-hidden="true">·</span>
      <span>{copy.footer.kvk} 98659456</span>
    </div>

    <small class="site-footer__copyright">&copy; {year} {copy.footer.copyright}</small>
  </div>

  <div class="site-footer__accent" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-y);
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-7);
    text-align: center;
    justify-items: center;
  }

  .site-footer__brand {
    display: inline-block;
  }

  .site-footer__brand :global(.site-footer__logo) {
    display: block;
    height: var(--logo-h);
    width: auto;
  }

  .site-footer__strapline {
    font-size: var(--fs-body);
    color: var(--color-text-soft);
    margin: 0;
    max-width: 44ch;
  }

  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    justify-content: center;
  }

  .site-footer__nav a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--fs-small);
  }

  .site-footer__nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-neo);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    justify-content: center;
    align-items: baseline;
    font-size: var(--fs-small);
    color: var(--color-text-soft);
  }

  .site-footer__meta a {
    color: var(--color-text-soft);
    text-decoration: none;
  }

  .site-footer__meta a:hover {
    color: var(--color-action);
    text-decoration: underline;
  }

  .site-footer__meta span[aria-hidden="true"] {
    color: var(--color-border);
  }

  .site-footer__copyright {
    font-size: var(--fs-small);
    color: var(--color-text-soft);
  }

  .site-footer__accent {
    height: 8px;
    background: var(--color-neo);
  }
</style>
