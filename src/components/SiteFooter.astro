---
import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import { navRoutes, routes } from "../i18n/routes";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const privacy = routes.find((r) => r.en === "/privacy/")!;
const year = new Date().getFullYear();

const socials: Array<{ label: string; href: string }> = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/danielfokker" },
  { label: "X", href: "https://x.com/orbis_neo" },
  { label: "Instagram", href: "https://www.instagram.com/orbisneo" },
];
---

<footer class="site-footer">
  <div class="site-footer__band container">
    <div class="site-footer__col site-footer__brand">
      <p class="site-footer__brand-name">{copy.footer.brand}</p>
      <p class="site-footer__strapline">{copy.footer.strapline}</p>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">{copy.footer.sitemapHeading}</h2>
      <ul>
        {navRoutes.map((r) => (
          <li><a href={r[lang]}>{copy.nav[r.navKey]}</a></li>
        ))}
        <li>
          <a href={privacy[lang]}>
            {lang === "en" ? "Privacy" : "Privacybeleid"}
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">{copy.footer.contactHeading}</h2>
      <ul>
        <li>
          {/* Placeholder tot open punt 4 (mailadres) is beslist */}
          <span>[PLACEHOLDER: info@orbisneoconsulting.com]</span>
        </li>
        <li>{copy.footer.city}</li>
        <li>{copy.footer.kvk} 98659456</li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">{copy.footer.socialHeading}</h2>
      <ul>
        {socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="site-footer__copyright container">
    <small>&copy; {year} {copy.footer.copyright}</small>
  </div>

  <div class="site-footer__accent" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-y);
    background: var(--gradient-footer);
    color: var(--color-text);
    position: relative;
    padding-top: var(--space-9);
  }

  .site-footer__band {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-7);
  }

  .site-footer__col {
    min-width: 0;
  }

  .site-footer__brand-name {
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-settings);
    font-weight: 650;
    font-size: 1.5rem;
    margin: 0 0 var(--space-2);
    color: var(--color-petrol);
  }

  .site-footer__strapline {
    color: var(--color-text-soft);
    margin: 0;
    max-width: 36ch;
  }

  .site-footer__heading {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-soft);
    margin: 0 0 var(--space-3);
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__col a {
    color: var(--color-text);
    text-decoration: none;
  }

  .site-footer__col a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-neo);
    text-decoration-thickness: 2px;
  }

  .site-footer__copyright {
    padding-block: var(--space-5) var(--space-6);
    color: var(--color-text-soft);
  }

  .site-footer__accent {
    height: 12px;
    background: var(--color-neo);
  }

  @media (max-width: 767.98px) {
    .site-footer__band {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .site-footer__strapline { margin-inline: auto; }

    .site-footer__col ul {
      align-items: center;
    }
  }

  @media (min-width: 768px) and (max-width: 1023.98px) {
    .site-footer__band {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
