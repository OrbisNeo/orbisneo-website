---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { inLang } from "../../i18n/utils";

const includeDrafts = import.meta.env.PUBLIC_SITE_ENV !== "production";
const all = await getCollection("nieuws", (e) => includeDrafts || !e.data.draft);
const editions = inLang(all, "nl").sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout
  title="Nieuws — Orbis Neo Consulting"
  description="Wekelijkse briefing over AI in organisaties, samengesteld door Vera en beoordeeld door Daniel Fokker."
  lang="nl"
>
  <section class="news container">
    <header class="news__header">
      <h1>Nieuws</h1>
      <p class="news__subtitle">Een wekelijkse briefing over AI in organisaties.</p>
    </header>

    {editions.length === 0 && (
      <p class="news__empty">
        [PLACEHOLDER: Nog geen gepubliceerde edities.]
      </p>
    )}

    <ul class="news__list">
      {editions.map((e) => (
        <li class="news-row">
          <a href={`/nieuws/${e.data.urlSlug}/`}>
            <p class="news-row__meta">
              <span>{e.data.week}</span>
              <time datetime={e.data.date.toISOString()}>
                {e.data.date.toLocaleDateString("nl-NL", { day: "numeric", month: "long", year: "numeric" })}
              </time>
              {e.data.draft && <span class="news-row__draft">concept</span>}
            </p>
            <h2>{e.data.title}</h2>
            <p>{e.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .news {
    padding-block: var(--section-y);
    max-width: 820px;
  }

  .news__header {
    margin-bottom: var(--space-7);
  }

  .news__subtitle {
    font-size: var(--fs-lead);
    color: var(--color-text-soft);
    margin: var(--space-2) 0 0;
  }

  .news__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }

  .news-row a {
    display: block;
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .news-row a:hover {
    background: var(--color-mist);
  }

  .news-row__meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-text-soft);
    margin: 0 0 var(--space-2);
    align-items: center;
  }

  .news-row__draft {
    background: var(--color-mist);
    color: var(--color-petrol);
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .news-row h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-h3);
  }

  .news-row p {
    margin: 0;
  }
</style>
