---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Content } from "../../legal/privacy.en.md";
---

<BaseLayout
  title="Privacy | Orbis Neo"
  description="Privacy statement of Orbis Neo: which data is processed, why, for how long and what your rights are."
  lang="en"
>
  <section class="prose container">
    <Content />
  </section>
</BaseLayout>

<style>
  .prose {
    padding-block: var(--section-y-compact);
    max-width: 820px;
  }

  .prose :global(h1) {
    margin-bottom: var(--space-4);
  }

  .prose :global(h2) {
    margin-top: var(--space-6);
  }

  .prose :global(h3) {
    margin-top: var(--space-5);
  }

  .prose :global(p),
  .prose :global(ul) {
    max-width: 68ch;
  }

  .prose :global(table) {
    border-collapse: collapse;
    margin-block: var(--space-4);
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: var(--space-2) var(--space-4) var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
</style>
