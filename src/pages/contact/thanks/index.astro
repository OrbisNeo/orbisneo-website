---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank you — Orbis Neo Consulting"
  description="Your message has been received."
  lang="en"
  noindex={true}
>
  <section class="thanks container">
    <h1>Thank you</h1>
    <p class="thanks__lead">
      Your message has been received. I'll come back to you within one working day. In the meantime, feel free to read a few blog posts or the services page.
    </p>
    <p class="thanks__links">
      <a href="/blog/" class="link">Read the blog</a>
      <span aria-hidden="true">·</span>
      <a href="/services/" class="link">See services</a>
    </p>
  </section>
</BaseLayout>

<style>
  .thanks {
    padding-block: var(--section-y);
    max-width: 680px;
  }

  .thanks__lead {
    font-size: var(--fs-lead);
    color: var(--color-text-soft);
    margin: var(--space-4) 0 var(--space-7);
  }

  .thanks__links {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    font-size: var(--fs-lead);
  }

  .link {
    color: var(--color-action);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
