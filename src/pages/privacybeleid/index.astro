---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PRIVACY_UPDATED } from "../../legal/meta";
import { Content } from "../../legal/privacy.nl.md";

const updated = PRIVACY_UPDATED
  ? new Date(PRIVACY_UPDATED).toLocaleDateString("nl-NL", { month: "long", year: "numeric", timeZone: "Europe/Amsterdam" })
  : "[PLACEHOLDER: datum van publicatie]";
---

<BaseLayout
  title="Privacybeleid | Orbis Neo"
  description="Privacybeleid van Orbis Neo: welke gegevens ik verwerk, waarom, hoe lang en welke rechten u heeft."
  lang="nl"
>
  <section class="prose container">
    <h1>Privacybeleid</h1>
    <p class="prose__date">Laatst gewijzigd: {updated}</p>
    <Content />
  </section>
</BaseLayout>

<style>
  .prose {
    padding-block: var(--page-head-pt) var(--section-y-compact);
    max-width: 820px;
  }

  .prose__date {
    color: var(--color-text-soft);
    margin-bottom: var(--space-5);
  }

  .prose h1 {
    margin-bottom: var(--space-4);
  }

  .prose :global(h2) {
    margin-top: var(--space-6);
  }

  .prose :global(h3) {
    margin-top: var(--space-5);
  }

  .prose :global(p),
  .prose :global(ul) {
    max-width: 68ch;
  }

  .prose :global(table) {
    border-collapse: collapse;
    margin-block: var(--space-4);
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: var(--space-2) var(--space-4) var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
</style>
