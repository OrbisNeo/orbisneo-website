---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import portrait from "../../assets/people/daniel-fokker.jpg";
import { inLang, sortByOrder } from "../../i18n/utils";

const all = await getCollection("cases");
const cases = sortByOrder(inLang(all, "nl"));
---

<BaseLayout
  title="Over — Orbis Neo Consulting"
  description="Over Daniel Fokker en Orbis Neo. Vijfentwintig jaar in de domeinen die AI nu het sterkst raakt."
  lang="nl"
>
  <section class="about container">
    <header class="about__header">
      <div class="about__intro">
        <h1>Over Daniel Fokker en Orbis Neo</h1>
        <p class="about__lead">
          Grip begint met feitelijk inzicht. Ik help directies van middelgrote en grote organisaties AI-ambitie vertalen naar praktische sturing — in domeinen waarin ik vijfentwintig jaar werk.
        </p>
      </div>
      <figure class="about__portrait">
        <Image
          src={portrait}
          alt="Daniel Fokker"
          widths={[280, 420, 560]}
          sizes="(max-width: 767px) 60vw, 420px"
          loading="eager"
        />
      </figure>
    </header>

    <section class="about__block">
      <h2>Waarom mijn achtergrond nu relevant is</h2>
      <p>
        AI raakt juist de domeinen waar ik al 25 jaar in werk: IT-delivery en softwareontwikkeling, IT-beheer, enterprise architecture, HR en IT financial management. De vragen die directies nu krijgen zijn geen vreemde thema's — het zijn vertrouwde thema's in een nieuwe context.
      </p>
    </section>

    <section class="about__block">
      <h2>Hoe ik werk</h2>
      <p>
        Interim of parttime, altijd met een eindpunt en een overdracht aan een interne eigenaar. Een à twee dagen per week, minimaal drie maanden. Vast ritme, directe toegang, periodieke rapportage aan de directie. Geen open trajecten en geen rapporten die in de kast blijven liggen.
      </p>
    </section>

    <section class="about__block">
      <h2>Volledige loopbaan</h2>
      <ol class="about__cases">
        {cases.map((c) => (
          <li class="about-case">
            <p class="about-case__period">{c.data.period}</p>
            <h3>{c.data.role}</h3>
            <p class="about-case__org">{c.data.org}</p>
            <dl>
              <dt>Situatie</dt>
              <dd>{c.data.situation}</dd>
              <dt>Resultaat</dt>
              <dd>{c.data.result}</dd>
            </dl>
          </li>
        ))}
      </ol>
    </section>

    <section class="about__block">
      <h2>Opleiding en kennis</h2>
      <ul class="about__list">
        <li>MSc Business Administration, Radboud Universiteit (2013–2017)</li>
        <li>BSc Business Informatics, Avans (1999–2002)</li>
        <li>TOGAF, ArchiMate, IT4IT, TBM/IT Financial Management, PRINCE2, SAFe/Agile/Scrum, Lean Six Sigma</li>
      </ul>
    </section>

    <section class="about__block">
      <h2>Over de naam: Orbis Neo</h2>
      <p>
        Orbis betekent cirkel of baan; Neo betekent nieuw. Samen: een nieuw perspectief op bekende organisaties. Het logo toont een netwerk van banen en knooppunten — hoe organisaties vandaag de dag feitelijk werken.
      </p>
    </section>

    <section class="about__block about__block--cta">
      <p>
        Benieuwd of dit bij uw situatie past? Een eerste gesprek duurt vijftien minuten en is vrijblijvend.
      </p>
      <p><a href="/kennismaken/" class="btn">Plan een kennismaking →</a></p>
    </section>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: var(--section-y);
  }

  .about__header {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-7);
    align-items: start;
    margin-bottom: var(--space-9);
  }

  .about__lead {
    font-size: var(--fs-lead);
    color: var(--color-text-soft);
    max-width: 52ch;
    margin: var(--space-4) 0 0;
  }

  .about__portrait {
    margin: 0;
  }

  .about__portrait :global(img) {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .about__block {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    max-width: 68ch;
  }

  .about__cases {
    list-style: none;
    padding: 0;
    counter-reset: case;
    max-width: none;
    display: grid;
    gap: var(--space-6);
  }

  .about-case {
    counter-increment: case;
    background: var(--color-surface);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    position: relative;
  }

  .about-case::before {
    content: counter(case);
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    font-family: var(--font-display);
    color: var(--color-neo);
    font-size: 2rem;
    font-weight: 600;
    opacity: 0.5;
  }

  .about-case__period {
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-soft);
    margin: 0 0 var(--space-2);
  }

  .about-case__org {
    color: var(--color-neo);
    font-weight: 600;
    margin: 0 0 var(--space-4);
  }

  .about-case dl {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .about-case dt {
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-soft);
  }

  .about-case dd {
    margin: 0;
  }

  .about__list {
    padding-left: var(--space-5);
  }

  .about__block--cta {
    text-align: center;
    margin-top: var(--space-9);
    padding: var(--space-7);
    background: var(--color-surface-warm);
    border-radius: var(--radius-lg);
    border-top: 0;
    max-width: none;
  }

  .btn {
    display: inline-flex;
    padding: 14px 28px;
    font-weight: 700;
    font-size: var(--fs-label);
    letter-spacing: 0.02em;
    border-radius: var(--radius-pill);
    text-decoration: none;
    background: var(--color-action);
    color: #fff;
    min-height: 44px;
  }

  @media (max-width: 767.98px) {
    .about__header {
      grid-template-columns: 1fr;
    }

    .about__portrait {
      order: -1;
    }

    .about__portrait :global(img) {
      max-width: 240px;
    }
  }
</style>
