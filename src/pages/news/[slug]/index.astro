---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { langOf } from "../../../i18n/utils";

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.PUBLIC_SITE_ENV !== "production";
  const all = await getCollection("nieuws", (e) => includeDrafts || !e.data.draft);
  return all
    .filter((e) => langOf(e) === "en")
    .map((edition) => ({
      params: { slug: edition.data.urlSlug },
      props: { edition },
    }));
}

const { edition } = Astro.props;
const { Content } = await render(edition);
const hasIntro = Boolean(edition.body?.trim());
const dateLabel = edition.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  title={`${edition.data.title} | News ${edition.data.week}`}
  description={edition.data.summary}
  lang="en"
  alternates={{
    en: `/news/${edition.data.urlSlug}/`,
    nl: `/nieuws/${edition.data.urlSlug}/`,
  }}
>
  <article class="edition container">
    <header class="edition__header">
      <p class="edition__meta">
        <span>{edition.data.week}</span>
        <time datetime={edition.data.date.toISOString()}>{dateLabel}</time>
        {edition.data.draft && <span class="edition__draft">draft</span>}
      </p>
      <h1>{edition.data.title}</h1>
      <p class="edition__summary">{edition.data.summary}</p>
    </header>

    {hasIntro && (
      <div class="edition__intro">
        <Content />
      </div>
    )}

    <ol class="items">
      {edition.data.items.map((item) => (
        <li class="item">
          <p class="item__source">
            {item.source}
            {item.sourceDate && (
              <>
                {" · "}
                <time datetime={item.sourceDate.toISOString()}>
                  {item.sourceDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
                </time>
              </>
            )}
          </p>
          <h2>
            <a href={item.url} target="_blank" rel="noopener">{item.title}</a>
          </h2>
          <p>{item.commentary}</p>
        </li>
      ))}
    </ol>

    <footer class="edition__footer">
      <p>Curated by {edition.data.curatedBy}, the Orbis Neo assistant, and reviewed by Daniel Fokker.</p>
    </footer>
  </article>
</BaseLayout>

<style>
  .edition {
    padding-block: var(--section-y);
    max-width: 820px;
  }

  .edition__meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-text-soft);
    margin: 0 0 var(--space-3);
    align-items: center;
  }

  .edition__draft {
    background: var(--color-mist);
    color: var(--color-petrol);
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .edition__summary {
    font-size: var(--fs-lead);
    color: var(--color-text-soft);
    max-width: 68ch;
    margin-top: var(--space-4);
  }

  .edition__intro {
    margin-top: var(--space-6);
    max-width: 68ch;
  }

  .items {
    list-style: none;
    padding: 0;
    margin: var(--space-8) 0 0;
    counter-reset: item;
    display: grid;
    gap: var(--space-7);
  }

  .item {
    counter-increment: item;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
  }

  .item__source {
    font-size: var(--fs-small);
    color: var(--color-text-soft);
    margin: 0 0 var(--space-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .item h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-h3);
  }

  .item h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .item h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-neo);
    text-decoration-thickness: 2px;
  }

  .edition__footer {
    margin-top: var(--space-9);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-soft);
    font-size: var(--fs-small);
  }
</style>
